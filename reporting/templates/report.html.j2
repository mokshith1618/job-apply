{#- The report page. Autoescape is on: every value from the tracker is escaped. Values come from render.py. -#}
{% macro cell(c) %}
{%- if c is link %}<a href="{{ c.href }}" target="_blank" rel="noopener noreferrer">{{ c.domain }}</a>
{%- elif c is status %}<span class="{{ c.cls }}">{{ c.text }}</span>
{%- elif c is not none %}{{ c }}{% endif -%}
{% endmacro %}
{% macro table(t) %}
<div class="table-wrap"><table>
<thead><tr>{% for h in t.headers %}<th{% if h in t.numeric %} class="num"{% endif %}>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for row in t.rows %}
<tr{% if t.row_classes and t.row_classes[loop.index0] %} class="{{ t.row_classes[loop.index0] }}"{% endif %}>
{%- for h, c in zip(t.headers, row) %}<td{% if h in t.numeric %} class="num"{% endif %}>{{ cell(c) }}</td>{% endfor -%}
</tr>
{% endfor %}
</tbody></table></div>
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Job search report</title>
<style>
{{ css }}
</style>
</head>
<body>
<main>
<h1>Job search report · {{ title_date }}</h1>

<section class="summary"><h2>Summary</h2>
{% for s in summary %}
<p>{{ s }}</p>
{% endfor %}
</section>

<div class="cards">
<section class="card"><h2>This week</h2>
{% for k, v in week_stats %}
<div class="stat"><span>{{ k }}</span><b>{{ v }}</b></div>
{% endfor %}
</section>
<section class="card"><h2>Needs your attention</h2>
{% if not attention_shown %}
<p>Nothing needs your attention.</p>
{% else %}
<ul class="plain">{% for line in attention_shown %}<li>{{ line }}</li>{% endfor %}</ul>
{% if attention_more %}
<details><summary>+{{ attention_more|length }} more</summary>
<ul class="plain">{% for line in attention_more %}<li>{{ line }}</li>{% endfor %}</ul></details>
{% endif %}
{% endif %}
</section>
</div>

<section><h2>Weekly</h2>
<svg viewBox="0 0 {{ chart.width }} {{ chart.height }}" role="img" aria-label="Applications per week">
{% for b in chart.bars %}
<g><title>{{ b.tip }}</title><rect class="bar" x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="2"></rect>
{%- if b.dot_y %}<circle class="dot" cx="{{ b.cx }}" cy="{{ b.dot_y }}" r="4"></circle>{% endif %}</g>
<text x="{{ b.cx }}" y="{{ chart.label_y }}" text-anchor="middle">{{ b.label }}</text>
{% endfor %}
<line class="target" x1="{{ chart.left }}" x2="{{ chart.right }}" y1="{{ chart.target_y }}" y2="{{ chart.target_y }}"></line>
<text x="{{ chart.right + 6 }}" y="{{ chart.target_label_y }}">target {{ chart.target }}</text>
<text x="{{ chart.left - 6 }}" y="{{ chart.zero_y }}" text-anchor="end">0</text>
<text x="{{ chart.left - 6 }}" y="{{ chart.top_y }}" text-anchor="end">{{ chart.top_value }}</text>
</svg>
<p class="note">Bars: applications per week. Dots: those that got a response. Dashed line: weekly target.</p>
<details><summary>Show numbers</summary>{{ table(weekly_numbers) }}</details>
</section>

<section><h2>Monthly</h2>
{% if monthly %}{{ table(monthly) }}{% else %}<p>No applications yet.</p>{% endif %}
</section>

<section><h2>Your responses ({{ responses_count }})</h2>
{% if responses %}{{ table(responses) }}{% else %}<p>No responses yet.</p>{% endif %}
</section>

<section><h2>Top 10 companies, with outcomes</h2>
{% if top %}{{ table(top) }}{% else %}<p>No applications yet.</p>{% endif %}
</section>

<section><h2>No reply after {{ no_reply_days }} days</h2>
<p>{{ no_reply_total }} with no reply after {{ no_reply_days }} days.</p>
{% if no_reply_months %}
<details><summary>By month</summary>
{% for m in no_reply_months %}
<details><summary>{{ m.name }} · {{ m.count }}</summary>{{ table(m.table) }}</details>
{% endfor %}
</details>
{% endif %}
</section>

<section><details><summary><h2>More details</h2></summary>
<p class="note">Rejection notices show how often companies tell you, not how well you did.</p>
{% for d in details %}
<h3>{{ d.title }}</h3>
{% if d.table.rows %}{{ table(d.table) }}{% else %}<p class="muted-text">None.</p>{% endif %}
{% endfor %}
</details></section>

<section><details><summary><h2>Data check ({{ issue_count }})</h2></summary>
{% if not issues %}
<p>No issues found.</p>
{% else %}
{% for i in issues %}
<h3>{{ i.name }} ({{ i.count }})</h3>
{{ table(i.table) }}
{% endfor %}
{% endif %}
</details></section>

<footer>Generated {{ stamp }} from {{ source_name }} · {{ row_count }}</footer>
</main>
</body>
</html>
